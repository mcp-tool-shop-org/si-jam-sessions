{
 "schema": "si-jam-research/evidence-manifest/1",
 "subject": "Battle Hymn of the Republic",
 "built_by": "work/build_manifest.py",
 "claims": {
  "C1-tune-first-publication": "The tune was in print by 1859 as the camp-meeting hymn 'Say, Brothers, Will You Meet Us?' with a 'Glory, glory, hallelujah' refrain; the earliest printing reported in the literature is 1858. No composer is named in the 1859 printings found; they credit arrangers only.",
  "C2-words-first-publication": "Julia Ward Howe's words were first published, unsigned, as 'Battle Hymn of the Republic' on p. 145 of The Atlantic Monthly, vol. IX, no. LII, February 1862 (Ticknor and Fields, Boston, copyright 1862).",
  "C3-howe-death": "Julia Ward Howe was born 27 May 1819 and died 17 October 1910.",
  "C4-steffe-dates": "William Steffe's dates are uncertain: the Library of Congress name authority gives 'approximately 1830-1890' from Claghorn's dictionary ('d. ca. 1890'). A Philadelphia Freemason named William Steffe (Past Master, Mozart Lodge No. 436) died in 1911; whether he is the same man is not established.",
  "C5-authorship-disputed": "Steffe's authorship is a claim, not an established fact: the LoC authority file enters the song under its title and cites Fuld that no claim to its composition can be sustained; Steffe, Thomas Brigham Bishop and Frank E. Jerome are the persistent claimants; an 1861 edition credits 'Phillip Simonds'; the Steffe story (1856, a Charleston fire company) appears in print by 1885.",
  "L1-eu-anonymous-term": "EU term (Directive 2006/116/EC art. 1): life of the author + 70 years; for anonymous works, 70 years after the work is lawfully made available to the public, unless the author's identity is disclosed in that period (then life + 70). Text read from legislation.gov.uk's copy of the Directive, because EUR-Lex answered HTTP 202 with an empty body.",
  "H1-source-edition": "The pinned source harmonisation is Oliver Ditson & Co., Boston, 1862 (plate 21454; deposited 9 April 1862), anonymous; its introduction and verse accompaniment already appear in Ditson's July 1861 'Glory, Hallelujah' edition, also anonymous."
 },
